{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edulinked-coder.github.io/Osteosarcoma-Therapeutic-Hypotheses-Open-Machine-Readable-Research/schemas/therapeutic-hypothesis.schema.json",
  "title": "Osteosarcoma Public Therapeutic Hypothesis",
  "description": "Canonical public research object for an evidence-bound osteosarcoma therapeutic hypothesis. It is not a clinical recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","hypothesis_id","title","hypothesis_statement","mechanism","targets_pathways","evidence_stage","supporting_evidence","contradictory_evidence","uncertainty","ranking","novelty","falsifiability","validation_requirements","provenance","review_state","supersession","clinical_use"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "hypothesis_id": {"type":"string","pattern":"^OS-TH-[0-9]{4}$"},
    "title": {"type":"string","minLength":10},
    "plain_language_summary": {"type":"string","minLength":20},
    "hypothesis_statement": {"type":"string","minLength":30},
    "mechanism": {"type":"object","required":["summary","relationships"],"additionalProperties":false,"properties":{"summary":{"type":"string","minLength":20},"relationships":{"type":"array","items":{"type":"object","required":["subject","predicate","object"],"additionalProperties":false,"properties":{"subject":{"type":"string"},"predicate":{"type":"string"},"object":{"type":"string"},"evidence_refs":{"type":"array","items":{"type":"string"}}}}}}},
    "targets_pathways": {"type":"array","minItems":1,"items":{"type":"object","required":["name","kind"],"additionalProperties":false,"properties":{"name":{"type":"string"},"kind":{"enum":["gene","protein","receptor","pathway","cell-state","microenvironment","process","intervention-class","other"]},"role":{"type":"string"}}}},
    "evidence_stage": {"enum":["computational","replicated-evidence","preclinical","clinical-investigation","clinically-validated","mixed"]},
    "supporting_evidence": {"type":"array","items":{"$ref":"#/$defs/evidenceBinding"}},
    "contradictory_evidence": {"type":"object","required":["status","items","assessment"],"additionalProperties":false,"properties":{"status":{"enum":["identified","none-identified","not-yet-assessed"]},"items":{"type":"array","items":{"$ref":"#/$defs/evidenceBinding"}},"assessment":{"type":"string","minLength":10}}},
    "uncertainty": {"type":"object","required":["level","summary","open_questions"],"additionalProperties":false,"properties":{"level":{"enum":["low","moderate","high","very-high"]},"summary":{"type":"string","minLength":20},"open_questions":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "ranking": {"type":"object","required":["status","score","scale","meaning","components"],"additionalProperties":false,"properties":{"status":{"enum":["ranked","pending-recalculation","not-ranked"]},"score":{"type":["number","null"],"minimum":0,"maximum":100},"scale":{"const":"0-100 research-priority score"},"meaning":{"const":"Research priority only; never expected patient benefit."},"components":{"type":"object","additionalProperties":{"type":["number","null"],"minimum":0,"maximum":100}}}},
    "novelty": {"type":"object","required":["status","assessment"],"additionalProperties":false,"properties":{"status":{"enum":["unverified","partially-checked","prior-art-reviewed"]},"assessment":{"type":"string","minLength":15}}},
    "falsifiability": {"type":"object","required":["falsification_conditions","discriminating_tests"],"additionalProperties":false,"properties":{"falsification_conditions":{"type":"array","minItems":1,"items":{"type":"string"}},"discriminating_tests":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "validation_requirements": {"type":"array","minItems":1,"items":{"type":"object","required":["stage","requirement"],"additionalProperties":false,"properties":{"stage":{"type":"string"},"requirement":{"type":"string"},"status":{"enum":["required","in-progress","satisfied","not-applicable"]}}}},
    "provenance": {"type":"object","required":["source_authority","generated_from","created_at","updated_at"],"additionalProperties":false,"properties":{"source_authority":{"type":"string"},"generated_from":{"type":"array","minItems":1,"items":{"type":"string"}},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"source_version":{"type":"string"}}},
    "review_state": {"type":"object","required":["status","scientific_review_required","publication_class"],"additionalProperties":false,"properties":{"status":{"enum":["machine-generated","human-review-required","reviewed","revision-required","withdrawn"]},"scientific_review_required":{"type":"boolean"},"publication_class":{"enum":["public-research-candidate","reviewed-public-hypothesis","superseded","withdrawn"]},"reviewed_at":{"type":["string","null"],"format":"date-time"},"review_note":{"type":"string"}}},
    "supersession": {"type":"object","required":["status","successor_id","reason"],"additionalProperties":false,"properties":{"status":{"enum":["current","superseded","withdrawn"]},"successor_id":{"type":["string","null"],"pattern":"^OS-TH-[0-9]{4}$"},"reason":{"type":["string","null"]}}},
    "clinical_use": {"const":false}
  },
  "$defs": {
    "evidenceBinding": {"type":"object","additionalProperties":false,"required":["evidence_id","citation","evidence_type","relationship","finding","source_url"],"properties":{"evidence_id":{"type":"string","pattern":"^(PMID-[0-9]+|DOI-[A-Za-z0-9._~%()!*'-]+|SOURCE-[A-Z0-9-]+)$"},"citation":{"type":"string"},"pmid":{"type":"string","pattern":"^[0-9]+$"},"doi":{"type":"string"},"evidence_type":{"enum":["computational","in-vitro","in-vivo","animal-model","patient-derived-model","observational-human","clinical-trial","systematic-review","narrative-review","multi-omics","other"]},"relationship":{"enum":["supports","contradicts","contextualises","limits"]},"finding":{"type":"string","minLength":15},"source_url":{"type":"string","format":"uri"}}}
  }
}
