{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edulinked-coder.github.io/Osteosarcoma-Therapeutic-Hypotheses-Open-Machine-Readable-Research/schemas/therapeutic-hypothesis.schema.json",
  "title": "Osteosarcoma Public Therapeutic Hypothesis",
  "description": "Canonical public research object for an evidence-bound osteosarcoma therapeutic hypothesis. It is not a clinical recommendation.",
  "$comment": "Operating-contract semantic aliases: generated timestamp = provenance.created_at; evidence-update timestamp = provenance.updated_at; publication state = review_state.publication_class; withdrawal state = supersession.status=withdrawn. These aliases avoid duplicate lifecycle fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","hypothesis_id","title","plain_language_summary","hypothesis_statement","mechanism","targets_pathways","evidence_stage","supporting_evidence","contradictory_evidence","uncertainty","ranking","novelty","falsifiability","validation_requirements","provenance","review_state","supersession","clinical_use"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "hypothesis_id": {"type":"string","pattern":"^OS-TH-[0-9]{4}$"},
    "title": {"type":"string","minLength":10},
    "plain_language_summary": {"type":"string","minLength":20},
    "hypothesis_statement": {"type":"string","minLength":30},
    "mechanism": {"type":"object","required":["summary","relationships"],"additionalProperties":false,"properties":{"summary":{"type":"string","minLength":20},"relationships":{"type":"array","items":{"type":"object","required":["subject","predicate","object"],"additionalProperties":false,"properties":{"subject":{"type":"string"},"predicate":{"type":"string"},"object":{"type":"string"},"evidence_refs":{"type":"array","items":{"type":"string","pattern":"^(PMID-[0-9]+|DOI-[A-Za-z0-9._~%()!*'-]+|SOURCE-[A-Z0-9-]+)$"}}}}}}},
    "targets_pathways": {"type":"array","minItems":1,"items":{"type":"object","required":["name","kind"],"additionalProperties":false,"properties":{"name":{"type":"string"},"kind":{"enum":["gene","protein","receptor","pathway","cell-state","microenvironment","process","intervention-class","other"]},"role":{"type":"string"}}}},
    "disease_context": {"type":"object","description":"Explicit disease and disease-state context. Unknown or unassessed context must remain explicit rather than inferred.","required":["disease","status","context"],"additionalProperties":false,"properties":{"disease":{"const":"osteosarcoma"},"status":{"enum":["specified","not-yet-assessed"]},"context":{"type":["string","null"],"minLength":3}}},
    "research_classification": {"const":"therapeutic-hypothesis","description":"Object classification only; it does not imply evidence maturity, scientific acceptance or clinical validity."},
    "evidence_stage": {"enum":["computational","replicated-evidence","preclinical","clinical-investigation","clinically-validated","mixed"]},
    "supporting_evidence": {"type":"array","items":{"$ref":"#/$defs/evidenceBinding"}},
    "contradictory_evidence": {"type":"object","required":["status","items","assessment"],"additionalProperties":false,"properties":{"status":{"enum":["identified","none-identified","not-yet-assessed"]},"items":{"type":"array","items":{"$ref":"#/$defs/evidenceBinding"}},"assessment":{"type":"string","minLength":10}}},
    "uncertainty": {"type":"object","required":["level","summary","open_questions"],"additionalProperties":false,"properties":{"level":{"enum":["low","moderate","high","very-high"]},"summary":{"type":"string","minLength":20},"open_questions":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "ranking": {"type":"object","required":["status","score","scale","meaning","components"],"additionalProperties":false,"properties":{"status":{"enum":["ranked","pending-recalculation","not-ranked"]},"score":{"type":["number","null"],"minimum":0,"maximum":100},"scale":{"const":"0-100 research-priority score"},"meaning":{"const":"Research priority only; never expected patient benefit."},"components":{"type":"object","additionalProperties":{"type":["number","null"],"minimum":0,"maximum":100}},"explanation":{"type":"string","minLength":20,"description":"Plain-language explanation of the research-priority state or score. It must not imply expected patient benefit."}}},
    "novelty": {"type":"object","required":["status","assessment"],"additionalProperties":false,"properties":{"status":{"enum":["unverified","partially-checked","prior-art-reviewed"]},"assessment":{"type":"string","minLength":15},"confidence":{"enum":["unverified","low","moderate","high"],"description":"Confidence in the novelty assessment, distinct from the novelty review status."}}},
    "falsifiability": {"type":"object","required":["falsification_conditions","discriminating_tests"],"additionalProperties":false,"properties":{"falsification_conditions":{"type":"array","minItems":1,"items":{"type":"string"}},"discriminating_tests":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "validation_requirements": {"type":"array","minItems":1,"items":{"type":"object","required":["stage","requirement"],"additionalProperties":false,"properties":{"stage":{"type":"string"},"requirement":{"type":"string"},"status":{"enum":["required","in-progress","satisfied","not-applicable"]}}}},
    "provenance": {"type":"object","required":["source_authority","generated_from","created_at","updated_at"],"additionalProperties":false,"properties":{"source_authority":{"type":"string"},"generated_from":{"type":"array","minItems":1,"items":{"type":"string"}},"created_at":{"type":"string","format":"date-time","description":"Generated timestamp for the canonical public hypothesis object."},"updated_at":{"type":"string","format":"date-time","description":"Canonical evidence-update timestamp used by public discovery projections; it does not imply literature surveillance completeness."},"source_version":{"type":"string"}}},
    "review_state": {"type":"object","required":["status","scientific_review_required","publication_class"],"additionalProperties":false,"properties":{"status":{"enum":["machine-generated","human-review-required","reviewed","revision-required","withdrawn"]},"scientific_review_required":{"type":"boolean"},"publication_class":{"enum":["public-research-candidate","reviewed-public-hypothesis","superseded","withdrawn"],"description":"Publication-state semantics for the public research object; this is not scientific acceptance or clinical authority."},"reviewed_at":{"type":["string","null"],"format":"date-time"},"review_note":{"type":"string"}}},
    "supersession": {"type":"object","required":["status","successor_id","reason"],"additionalProperties":false,"properties":{"status":{"enum":["current","superseded","withdrawn"],"description":"Lifecycle state including current, superseded or withdrawn; withdrawal requires the existing governed lifecycle checks."},"successor_id":{"type":["string","null"],"pattern":"^OS-TH-[0-9]{4}$"},"reason":{"type":["string","null"]}}},
    "accessibility": {"type":"object","description":"Accessibility projection metadata derived from the same canonical research object; it is not independent scientific content or certification.","required":["plain_language_summary","easy_read_projection","projection_status","meaning"],"additionalProperties":false,"properties":{"plain_language_summary":{"const":"canonical"},"easy_read_projection":{"type":"string","pattern":"^hypotheses/OS-TH-[0-9]{4}/easy-read/$"},"projection_status":{"enum":["generated","not-yet-generated"]},"meaning":{"const":"Accessibility projections derive from the canonical hypothesis object and do not add scientific facts or claim independent certification."}}},
    "clinical_use": {"const":false}
  },
  "$defs": {
    "evidenceBinding": {"type":"object","additionalProperties":false,"required":["evidence_id","citation","evidence_type","relationship","finding","source_url"],"properties":{"evidence_id":{"type":"string","pattern":"^(PMID-[0-9]+|DOI-[A-Za-z0-9._~%()!*'-]+|SOURCE-[A-Z0-9-]+)$"},"citation":{"type":"string"},"pmid":{"type":"string","pattern":"^[0-9]+$"},"doi":{"type":"string"},"evidence_type":{"enum":["computational","in-vitro","in-vivo","animal-model","patient-derived-model","observational-human","clinical-trial","systematic-review","narrative-review","multi-omics","other"]},"relationship":{"enum":["supports","contradicts","contextualises","limits","neutral"]},"finding":{"type":"string","minLength":15},"source_url":{"type":"string","format":"uri"}}}
  }
}
