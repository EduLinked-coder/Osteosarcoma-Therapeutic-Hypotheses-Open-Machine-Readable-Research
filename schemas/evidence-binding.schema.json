{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edulinked-coder.github.io/Osteosarcoma-Therapeutic-Hypotheses-Open-Machine-Readable-Research/schemas/evidence-binding.schema.json",
  "title": "Osteosarcoma Public Evidence Binding",
  "description": "Governed public evidence binding for a therapeutic hypothesis. A binding records how a public source relates to a hypothesis; it is not an acceptance of clinical efficacy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_binding_version",
    "evidence_id",
    "source_type",
    "canonical_source_url",
    "citation",
    "publication_date",
    "evidence_type",
    "evidence_maturity",
    "biological_model",
    "evidence_context",
    "relationship_to_hypothesis",
    "hypothesis_components",
    "finding",
    "independence_from_other_evidence",
    "replication_status",
    "provenance",
    "clinical_use"
  ],
  "$defs": {
    "assessed_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "enum": [
            "reported",
            "not-reported-in-public-source",
            "not-applicable",
            "not-yet-assessed"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "note": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  },
  "properties": {
    "evidence_binding_version": {
      "const": "1.1.0"
    },
    "evidence_id": {
      "type": "string",
      "description": "Stable single-path-segment identifier. PMID IDs use PMID-<digits>. DOI IDs use DOI- followed by encodeURIComponent(lowercase doi), so DOI slashes are percent-encoded rather than filesystem separators.",
      "pattern": "^(PMID-[0-9]+|DOI-[A-Za-z0-9._~%()!*'-]+|SOURCE-[A-Z0-9-]+)$"
    },
    "source_type": {
      "enum": [
        "pubmed",
        "doi",
        "preprint",
        "clinical-trial-registry",
        "public-dataset",
        "other-public-source"
      ]
    },
    "pmid": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "doi": {
      "type": "string",
      "minLength": 3
    },
    "canonical_source_url": {
      "type": "string",
      "format": "uri"
    },
    "citation": {
      "type": "string",
      "minLength": 10
    },
    "publication_date": {
      "type": "string",
      "minLength": 4
    },
    "evidence_type": {
      "enum": [
        "computational",
        "in-vitro",
        "in-vivo",
        "animal-model",
        "patient-derived-model",
        "observational-human",
        "clinical-trial",
        "systematic-review",
        "narrative-review",
        "multi-omics",
        "other"
      ]
    },
    "evidence_maturity": {
      "enum": [
        "computational",
        "preclinical",
        "contextual",
        "clinical-observational",
        "clinical-interventional",
        "review-source",
        "mixed"
      ]
    },
    "biological_model": {
      "type": "string",
      "minLength": 3
    },
    "evidence_context": {
      "type": "object",
      "description": "Explicit assessment of experimental model, population/context and mechanism metadata. Unknown or unassessed context must remain explicit rather than being inferred from citation text.",
      "additionalProperties": false,
      "required": [
        "experimental_model",
        "population_context",
        "mechanism"
      ],
      "properties": {
        "experimental_model": {
          "$ref": "#/$defs/assessed_text"
        },
        "population_context": {
          "$ref": "#/$defs/assessed_text"
        },
        "mechanism": {
          "$ref": "#/$defs/assessed_text"
        }
      }
    },
    "relationship_to_hypothesis": {
      "enum": [
        "SUPPORTS",
        "CONTRADICTS",
        "LIMITS",
        "CONTEXTUALISES",
        "FAILED_REPLICATION",
        "SUCCESSOR_CONTEXT"
      ]
    },
    "hypothesis_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "finding": {
      "type": "string",
      "minLength": 15
    },
    "independence_from_other_evidence": {
      "type": "string",
      "minLength": 10
    },
    "replication_status": {
      "enum": [
        "not-yet-assessed",
        "not-applicable-review-source",
        "replicated",
        "failed-replication",
        "mixed",
        "single-source-only"
      ]
    },
    "acceptance_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "meaning"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate-public-evidence",
            "reviewed-public-evidence",
            "rejected",
            "superseded"
          ]
        },
        "meaning": {
          "const": "Presence in this repository records a public evidence relationship; it does not establish accepted evidence or clinical benefit."
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review_note": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_source",
        "retrieval_date",
        "binding_generated_for"
      ],
      "properties": {
        "public_source": {
          "type": "string",
          "minLength": 3
        },
        "retrieval_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "binding_generated_for": {
          "type": "string",
          "pattern": "^OS-TH-[0-9]{4}$"
        },
        "created_by": {
          "type": "string"
        },
        "source_accessed_by": {
          "type": "string"
        }
      }
    },
    "clinical_use": {
      "const": false
    }
  }
}
